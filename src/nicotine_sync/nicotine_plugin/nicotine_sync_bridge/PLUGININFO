Name = "Nicotine+ Sync Bridge"
Version = "0.3.0"
Authors = ["Nicotine+ Sync"]
Description = "Lets the Nicotine+ Sync app search and download through Nicotine+, using your own Soulseek account. Only listens on this computer (127.0.0.1) and only accepts requests with the key that Nicotine+ Sync created when it installed this plugin.\n\nNicotine+ Sync searches don't show up as tabs or in your search history. Downloads appear in the Downloads tab as usual."
