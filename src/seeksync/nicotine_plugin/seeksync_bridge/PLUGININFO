Name = "SeekSync Bridge"
Version = "0.5.1"
Authors = ["SeekSync"]
Description = "Lets the SeekSync app search and download through Nicotine+, using your own Soulseek account. Only listens on this computer (127.0.0.1) and only accepts requests with the key that SeekSync created when it installed this plugin.\n\nSeekSync searches don't show up as tabs or in your search history. Downloads appear in the Downloads tab as usual."
